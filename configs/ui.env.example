# Regulus UI profile (scripts/start_ui.sh): this machine's paths only. Copy to configs/ui.env (not committed).
# Answering model: Qwen3-4B-Instruct-2507, MLX 4-bit (mlx-community build). Qwen3-1.7B MLX 4-bit is also accepted.
REGULUS_MODEL_BACKEND=mlx
# the tokenizer the server loads; Qwen3 models share it byte for byte (serve_ui checks against the snapshot's file)
REGULUS_MODEL_ID=Qwen/Qwen3-1.7B
REGULUS_MODEL_CACHE_DIR=/path/to/hf_cache
# a Python with mlx-lm installed, and the model snapshot directory
REGULUS_MLX_PYTHON=/path/to/mlx_venv/bin/python
REGULUS_MLX_MODEL_PATH=/path/to/models--mlx-community--Qwen3-4B-Instruct-2507-4bit/snapshots/50d427756c6b1b2fe0c0a10f67fbda1fc8e82c1b
REGULUS_MLX_REVISION=50d427756c6b1b2fe0c0a10f67fbda1fc8e82c1b
REGULUS_MLX_MIN_AVAILABLE_MB=2600
REGULUS_REPETITION_PENALTY=1.1
# REGULUS_DEPLOYMENT_SCOPE: leave unset - every question is read against all of Title 21; a question naming a
# cosmetic product or programme still gets the cosmetics prior (measured 26 Oct: bank 179 -> 178 key sections among
# the candidates, 300-question benchmark 63 -> 136)
# REGULUS_DEPLOYMENT_SCOPE=cosmetics
# the cross-encoder reranker lives in models/ (scripts/fetch_rerankers.py downloads it at its pinned revision)

# --- Windows / Linux (scripts/start_ui.ps1) ----------------------------------------------------------------------
# The same MLX 4-bit model directory and revision, run by PyTorch (scripts/torch_worker.py) instead of MLX: drop
# REGULUS_MLX_PYTHON (the project's own .venv runs the worker) and add the lines below. Paths may be relative to the
# project root, e.g. REGULUS_MODEL_CACHE_DIR=models and REGULUS_MLX_MODEL_PATH=models/models--mlx-community--...
# README_LOCAL_SETUP.md has the downloads and the CUDA / Triton install.
# REGULUS_WORKER_RUNTIME=torch
# REGULUS_TORCH_DEVICE=auto        # auto = CUDA when available (float16), else CPU (float32, very slow); cuda | cuda:N | cpu
# REGULUS_TORCH_DTYPE=auto         # auto | float16 | bfloat16 | float32
# PYTHONUTF8=1                     # Windows: read text files as UTF-8, as macOS does
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
