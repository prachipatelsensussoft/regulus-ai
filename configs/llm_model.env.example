# llm-model API profile (scripts/start_llm_model.sh). Copy to configs/llm_model.env (git-ignored) and fill it in.
# Nothing here is specific to one Mac except what you put in it.

# --- access -----------------------------------------------------------------------------------------------------
# comma-separated id:secret pairs; regulus-backend sends "Authorization: Bearer <secret>". Secrets: 24+ characters,
# e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`. The id is what the log shows.
LLM_MODEL_API_KEYS=backend:CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LLM_MODEL_RATE_PER_MIN=30
LLM_MODEL_MAX_BODY_BYTES=65536
LLM_MODEL_QUEUE_WAIT_S=300

# --- network ----------------------------------------------------------------------------------------------------
# 127.0.0.1 = this Mac only. For other machines: 0.0.0.0 with TLS (both files), or --behind-proxy with an HTTPS proxy
LLM_MODEL_HOST=127.0.0.1
LLM_MODEL_PORT=8100
# LLM_MODEL_TLS_CERT=/path/to/cert.pem
# LLM_MODEL_TLS_KEY=/path/to/key.pem

# --- the shared database ----------------------------------------------------------------------------------------
# one PostgreSQL server for every Mac that runs the API; a read-only role is enough
REGULUS_DATABASE_URL=postgresql://regulus_ro:PASSWORD@db-host:5432/regulus

# --- the model (as in configs/ui.env.example) -------------------------------------------------------------------
REGULUS_MODEL_BACKEND=mlx
REGULUS_MODEL_ID=Qwen/Qwen3-1.7B
REGULUS_MODEL_CACHE_DIR=/path/to/hf_cache
REGULUS_MLX_PYTHON=/path/to/mlx_venv/bin/python
REGULUS_MLX_MODEL_PATH=/path/to/models--mlx-community--Qwen3-4B-Instruct-2507-4bit/snapshots/50d427756c6b1b2fe0c0a10f67fbda1fc8e82c1b
REGULUS_MLX_REVISION=50d427756c6b1b2fe0c0a10f67fbda1fc8e82c1b
REGULUS_MLX_MIN_AVAILABLE_MB=2600
REGULUS_REPETITION_PENALTY=1.1

# --- Windows / Linux (scripts/start_llm_model.ps1): as in configs/ui.env.example, drop REGULUS_MLX_PYTHON and add
# REGULUS_WORKER_RUNTIME=torch
# REGULUS_TORCH_DEVICE=auto
# PYTHONUTF8=1
