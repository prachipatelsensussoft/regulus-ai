# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Virtual environment
.venv/

# Environment / secrets
.env

# Model weights and Hugging Face cache (never commit).
# Stage 12 LoRA runs live under models/qwen3-0.6b-lora/<run>/: the adapter and
# checkpoints are regenerated by scripts/train_model.py, the small metadata
# files are worth keeping.
models/*
!models/.gitkeep
!models/qwen3-0.6b-lora/
models/qwen3-0.6b-lora/*/adapter/
models/qwen3-0.6b-lora/*/checkpoints/
models/qwen3-0.6b-lora/*/tokenizer/
models/qwen3-0.6b-lora/smoke_tmp/
models/qwen3-0.6b-lora/*smoke_tmp/

# Data (keep folder structure, not contents)
data/raw/*
data/processed/*
# chat conversations (local SQLite, scripts/serve_ui.py): user content, never committed
data/chat/
# UI measurement sessions (regulus.traceability.ui_session): user questions and answers, never committed
data/ui_measurements/
!data/**/.gitkeep

# Evaluation: benchmark datasets ARE tracked; run results are not (commit
# a specific result file deliberately with `git add -f` when it is a reference).
data/evaluation/results/*
!data/evaluation/results/.gitkeep

# Stage 8 semantic experiment: manifest is tracked, extracted corpus and vectors are generated
data/evaluation/semantic/generated/
# Stage 10 versioned corpora: <name>/manifest.yaml tracked, <name>/generated/ reproducible
data/evaluation/semantic/*/generated/
# backups of a generated/ folder (python -m regulus.setup semantic: generated_backup_<time>/; manual generated_before_*)
data/evaluation/semantic/*/generated_*/

# Stage 11 training data: JSONL splits are regenerated deterministically from the database
# (manifest_<v>.json and validation_<v>.json are tracked)
data/training/datasets/*.jsonl

# Logs
logs/*
!logs/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only (added when the repository was created)
.venv-windows-reference/
logs/
.DS_Store

# configs/ui.env: local profile for scripts/start_ui.sh (paths of this machine)
configs/ui.env
# configs/llm_model.env: local profile for scripts/start_llm_model.sh (keys and paths of this machine)
configs/llm_model.env
